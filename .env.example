# ==============================================================================
# ZEXO LICENSE SERVER — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT:
# - Never commit actual .env files containing production secrets to Git.
# - In Render (or cloud hosting), configure these in the Service Environment dashboard.
# ==============================================================================

# Server Environment: development | staging | production | test
NODE_ENV=development

# Server Port (Render sets this automatically to 10000; default local is 5000)
PORT=5000

# Server Host
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# For Development: Leave empty to use local zero-dependency SQLite (licenses.db)
# For Production: Connect managed PostgreSQL instance to ensure permanent data persistence
# Example: postgresql://zexo_admin:YOUR_SECURE_PASSWORD@dpg-xxxxx.render.com/zexo_licenses
DATABASE_URL=

# ------------------------------------------------------------------------------
# ADMIN CREDENTIALS & PRODUCTION SECURITY
# ------------------------------------------------------------------------------
# Primary Admin Username
ADMIN_USERNAME=MADARA-FF

# Admin Password (REQUIRED in production, minimum 8 characters)
# In development, defaults to ABHISHEK! if omitted.
ADMIN_PASSWORD=

# Admin Contact Email
ADMIN_EMAIL=madara-ff@rootoptimizer.com

# Admin API Master Secret (REQUIRED in production, minimum 16 characters)
# Used for authorization on /api/app/publish and /api/auth/admin/setup
# Aliased with ADMIN_SECRET_KEY for backward compatibility.
ADMIN_SECRET=

# Set to 'true' only if you deliberately need to force-update existing admin credentials on boot
FORCE_ADMIN_PASSWORD_RESET=false

# ------------------------------------------------------------------------------
# APPLICATION VERSIONING & DOWNLOADS
# ------------------------------------------------------------------------------
APP_LATEST_VERSION=1.3.6
APP_VERSION_CODE=38
APP_MIN_VERSION=1.0.0
APP_DOWNLOAD_URL=/api/app/download

# ------------------------------------------------------------------------------
# CLOUD SYNCHRONIZATION (Development Only)
# ------------------------------------------------------------------------------
# Target cloud server for bidirectional key sync
CLOUD_SERVER_URL=https://optimizer-stzd.onrender.com
# Set to 'true' in development only if you want automatic cloud sync on startup
AUTO_SYNC_CLOUD=false
